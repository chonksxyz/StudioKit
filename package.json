{
  "name": "@chonksxyz/studio",
  "version": "0.3.0",
  "description": "A dependency-free toolkit for building pixel art studios: configurable grids, undo/redo history, draw and erase input, multi-cell selection with drag-to-move, configurable keyboard shortcuts, image export, and design persistence.",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "author": "Chonks (https://www.chonks.xyz)",
  "homepage": "https://github.com/chonksxyz/StudioKit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chonksxyz/StudioKit.git"
  },
  "bugs": {
    "url": "https://github.com/chonksxyz/StudioKit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.build.json",
    "prepack": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pixel-art",
    "editor",
    "drawing",
    "canvas",
    "grid",
    "selection",
    "undo",
    "keyboard-shortcuts"
  ]
}
